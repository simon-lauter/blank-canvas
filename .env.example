# Environment Variables Example
# Copy this file to .env.local and update with your values
# Variables prefixed with VITE_ are exposed to client-side code

# Application Configuration
VITE_APP_TITLE="React + Vite Blueprint"

# API Configuration
# VITE_API_URL=https://api.example.com
# VITE_API_TIMEOUT=30000

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG_MODE=false

# Third-party Services
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# Note: Never commit .env.local or .env files with sensitive data!
# Only VITE_ prefixed variables are available in the browser.
